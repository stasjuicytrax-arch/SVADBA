# Скопируйте в server/.env (или задайте эти переменные в панели хостинга).
# Файл .env в git не попадает — токен бота нигде больше хранить не нужно.

# Токен бота от @BotFather
TELEGRAM_BOT_TOKEN=

# Куда слать уведомления: ваш личный chat_id или id группы (с минусом)
TELEGRAM_CHAT_ID=

# Порт, который слушает server.js
PORT=8080

# Адрес обработчика внутри сервера
LEAD_PATH=/api/lead

# Домен сайта — с него разрешены запросы к обработчику
ALLOWED_ORIGIN=https://help-wedding.ru

# Куда складывать заявки (первичное хранение — на сервере в России)
LEADS_FILE=./server/data/leads.jsonl

# Сколько заявок с одного IP за 10 минут
RATE_LIMIT=5
